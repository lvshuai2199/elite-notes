          if forward_speed <= 0:
              forward_speed = measured_forward_speed
          end
          if motion_started != True:
              if forward_speed > full_swing_min_forward_speed:
                  motion_started = True
                  active_time = 0.0
                  active_distance = 0.0
              else:
                  full_swing_apply_limited_offset(full_zero_offset(), control_dt)
              end
          end
          if motion_started == True:
              active_time = active_time + control_dt
              active_distance = active_distance + forward_speed * control_dt
              period_length = full_swing_period_length(params, forward_speed)
              if period_length > 0:
                  if process != max_offset_process:
                      max_trans_offset = params.amplitude + 0.01
                      if params.type == 0 or params.type == 2:
                          max_trans_offset = max_trans_offset + period_length
                      elif params.type == 1:
                          max_trans_offset = max_trans_offset + period_length / 2.0 + params.width
                      end
                      if max_trans_offset < 0.05:
                          max_trans_offset = 0.05
                      end
                      path_offset_set_max_offset(max_trans_offset, 1.0)
                      max_offset_process = process
                  end
                  phase = full_swing_phase(active_distance, period_length)
                  target_offset = full_swing_offset(params, phase, forward_speed, period_length)
                  exact_stop = False
                  if params.type == 0:
                      left_ratio = full_swing_dwell_ratio(params.left_stay_time, forward_speed, period_length)
                      right_ratio = full_swing_dwell_ratio(params.right_stay_time, forward_speed, period_length)
