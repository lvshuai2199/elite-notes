      full_swing_apply_offset(full_zero_offset())
      full_swing_last_velocity = full_zero_offset()
      last_pose = full_swing_center_tcp_pose()
      last_time = time.time()
      active_distance = 0.0
      motion_started = False
      active_time = 0.0
      while full_swing_enabled == True and full_swing_process_index >= 0:
          process = full_swing_process_index
          params = SwingParameters[process]
          now = time.time()
          dt = now - last_time
          last_time = now
          if dt <= 0 or dt > 0.1:
              dt = full_swing_control_period
          end
          control_dt = full_swing_control_period
          pose = full_swing_center_tcp_pose()
