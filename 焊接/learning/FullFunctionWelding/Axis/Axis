    elif (abs(ver_vec[2])>abs(ver_vec[0]))&(abs(ver_vec[2])>abs(ver_vec[1])):
      pnt3_local[2]=0
      touch3_local[2]=0
      touch1_local[2]=0
      touch2_local[2]=0
    else:
