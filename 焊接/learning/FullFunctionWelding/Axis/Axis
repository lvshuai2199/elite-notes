  def full_swing_stopping_offset(dt):
      global full_swing_control_period
      global full_swing_last_offset
      global full_swing_last_velocity
      global full_swing_max_offset_speed
      global full_swing_max_offset_accel
      if dt <= 0 or dt > full_swing_control_period:
          dt = full_swing_control_period
      end
      delta = [0,0,0,0,0,0]
      result = [0,0,0,0,0,0]
      desired_velocity = [0,0,0,0,0,0]
      velocity_delta = [0,0,0,0,0,0]
      velocity = [0,0,0,0,0,0]
      step = [0,0,0,0,0,0]
      exact_velocity = [0,0,0,0,0,0]
      exact_velocity_delta = [0,0,0,0,0,0]
      i = 0
      while i < 6:
          delta[i] = -full_swing_last_offset[i]
          i = i + 1
      end
      distance = full_swing_offset_distance(delta)
      max_velocity_delta = full_swing_max_offset_accel * dt
      desired_speed = 0.0
      if distance > 0.000000001:
          desired_speed = distance / dt
          if desired_speed > full_swing_max_offset_speed:
              desired_speed = full_swing_max_offset_speed
          end
          braking_speed = full_sqrt(2.0 * full_swing_max_offset_accel * distance)
          if desired_speed > braking_speed:
              desired_speed = braking_speed
          end
          i = 0
          while i < 6:
              desired_velocity[i] = delta[i] / distance * desired_speed
              i = i + 1
          end
      end
      i = 0
      while i < 6:
          velocity_delta[i] = desired_velocity[i] - full_swing_last_velocity[i]
          i = i + 1
      end
      velocity_delta_distance = full_swing_offset_distance(velocity_delta)
      accel_scale = 1.0
      if velocity_delta_distance > max_velocity_delta and velocity_delta_distance > 0:
          accel_scale = max_velocity_delta / velocity_delta_distance
      end
      i = 0
      while i < 6:
          velocity[i] = full_swing_last_velocity[i] + velocity_delta[i] * accel_scale
          step[i] = velocity[i] * dt
          exact_velocity[i] = delta[i] / dt
          exact_velocity_delta[i] = exact_velocity[i] - full_swing_last_velocity[i]
          i = i + 1
      end
      step_distance = full_swing_offset_distance(step)
      exact_velocity_distance = full_swing_offset_distance(exact_velocity)
      exact_velocity_delta_distance = full_swing_offset_distance(exact_velocity_delta)
      step_dot_delta = step[0] * delta[0] + step[1] * delta[1] + step[2] * delta[2]
      if step_dot_delta > 0 and step_distance >= distance and exact_velocity_distance <= max_velocity_delta and exact_velocity_delta_distance <= max_velocity_delta:
          full_swing_last_velocity = full_copy_offset(exact_velocity)
          return full_zero_offset()
      end
      i = 0
      while i < 6:
          result[i] = full_swing_last_offset[i] + step[i]
          i = i + 1
      end
      full_swing_last_velocity = full_copy_offset(velocity)
      return result
