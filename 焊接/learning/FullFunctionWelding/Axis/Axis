      delta = [0,0,0,0,0,0]
      result = [0,0,0,0,0,0]
      velocity = [0,0,0,0,0,0]
      desired_velocity = [0,0,0,0,0,0]
      velocity_delta = [0,0,0,0,0,0]
      i = 0
      while i < 6:
          delta[i] = target_offset[i] - full_swing_last_offset[i]
          i = i + 1
      end
      distance = full_swing_offset_distance(delta)
      if distance <= 0.000000001:
          full_swing_last_velocity = full_zero_offset()
          return full_copy_offset(target_offset)
      end
      speed_scale = 1.0
      desired_speed = distance / dt
      if desired_speed > full_swing_max_offset_speed:
          speed_scale = full_swing_max_offset_speed / desired_speed
      end
      i = 0
      while i < 6:
          desired_velocity[i] = delta[i] / dt * speed_scale
          velocity_delta[i] = desired_velocity[i] - full_swing_last_velocity[i]
          i = i + 1
      end
      velocity_delta_distance = full_swing_offset_distance(velocity_delta)
      max_velocity_delta = full_swing_max_offset_accel * dt
      accel_scale = 1.0
      if velocity_delta_distance > max_velocity_delta and velocity_delta_distance > 0:
          accel_scale = max_velocity_delta / velocity_delta_distance
      end
      step = [0,0,0,0,0,0]
      i = 0
      while i < 6:
          velocity[i] = full_swing_last_velocity[i] + velocity_delta[i] * accel_scale
          step[i] = velocity[i] * dt
          i = i + 1
      end
      step_distance = full_swing_offset_distance(step)
      if step_distance >= distance:
          full_swing_last_velocity = full_copy_offset(desired_velocity)
          return full_copy_offset(target_offset)
      end
      i = 0
      while i < 6:
          result[i] = full_swing_last_offset[i] + step[i]
          i = i + 1
      end
      full_swing_last_velocity = full_copy_offset(velocity)
      return result
  end
